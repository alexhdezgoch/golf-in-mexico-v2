{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "create-react-app",
  "redirects": [
    {
      "source": "/destinations/los-cabos/courses/vidanta-golf-los-cabos",
      "destination": "/destinations/los-cabos",
      "permanent": true
    },
    {
      "source": "/experience",
      "destination": "/trips",
      "permanent": true
    },
    {
      "source": "/cancun/golf-packages",
      "destination": "/destinations/cancun-riviera-maya/golf-packages",
      "permanent": true
    },
    {
      "source": "/los-cabos/golf-packages",
      "destination": "/destinations/los-cabos/golf-packages",
      "permanent": true
    },
    {
      "source": "/vallarta/golf-packages",
      "destination": "/destinations/puerto-vallarta/golf-packages",
      "permanent": true
    },
    {
      "source": "/cdmx/private-access",
      "destination": "/destinations/mexico-city",
      "permanent": true
    },
    {
      "source": "/destinations/mexico-city/private-access",
      "destination": "/destinations/mexico-city",
      "permanent": true
    },
    {
      "source": "/golf/unique-destinations",
      "destination": "/destinations/unique-destinations",
      "permanent": true
    },
    {
      "source": "/journal/los-cabos",
      "destination": "/destinations/los-cabos",
      "permanent": true
    },
    {
      "source": "/journal/punta-mita-golf-cost-green-fees",
      "destination": "/destinations/punta-mita",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/founders/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/images/g/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=31536000"
        }
      ]
    }
  ]
}
