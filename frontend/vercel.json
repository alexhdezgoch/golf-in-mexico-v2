{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "yarn build",
  "outputDirectory": "build",
  "redirects": [
    { "source": "/cancun/golf-packages", "destination": "/destinations/cancun-riviera-maya/golf-packages", "permanent": true },
    { "source": "/los-cabos/golf-packages", "destination": "/destinations/los-cabos/golf-packages", "permanent": true },
    { "source": "/vallarta/golf-packages", "destination": "/destinations/puerto-vallarta/golf-packages", "permanent": true },
    { "source": "/cdmx/private-access", "destination": "/destinations/mexico-city/private-access", "permanent": true },
    { "source": "/golf/unique-destinations", "destination": "/destinations/unique-destinations", "permanent": true },
    { "source": "/journal/los-cabos", "destination": "/destinations/los-cabos", "permanent": true }
  ],
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
